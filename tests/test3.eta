func(x : int) : int {
    y : int = x;
    for ; x > 10; x = x - 1{
        y = x;
        if(x == 39){
            return y;
        }
    }
    return y; 
}
main() : int {
    a : int = 0
    for i : int = 0
        i<40
        i = i +1 
    {
        a = i; 
    }
    a = a - func(a)
    return a;
}